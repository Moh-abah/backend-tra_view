+    if col:
+        return col
+    return ZLF_E2E_TRENDY_QUANTUM_EMA_COLOR_FALLBACKS[
+        (n * 7 + 3) % len(ZLF_E2E_TRENDY_QUANTUM_EMA_COLOR_FALLBACKS)]

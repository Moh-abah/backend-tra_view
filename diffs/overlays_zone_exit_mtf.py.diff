+def _same_base_step(t: "np.ndarray") -> Optional[int]:
+    """خطوة شمعة القاعدة (متينة أمام الفجوات — نفس عقد compute_zone_exit_mtf)."""
+    if int(t.size) < 2:
+        return None
+    diffs = np.diff(t)
+    pos = diffs[diffs > 0]
+    return int(pos.min()) if pos.size else 60_000
+

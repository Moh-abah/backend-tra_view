{
    "name": "Volume & Price Color Streak Test Strategy",
    "description": "اختبار الباك-تست مع استراتيجيه كليماكس",
    "mode": "standard",
    "start_date": "2026-01-05T00:00:00",
    "end_date": "2026-01-22T00:00:00",
    "timeframe": "1h",
    "market": "crypto",
    "symbols": [
        "ETHUSDT"
    ],
    "strategy_config": {
        "name": "Volume & Price Color Streak Test Strategy",
        "version": "1.0.1",
        "description": "استراتيجية اختبارية للتحقق من منطق الاستمرارية (Streaks): 3 فوليوم زرقاء + 3 شموع ملونة",
        "base_timeframe": "1h",
        "position_side": "both",
        "indicators": [
            {
                "id": "volume_climax",
                "name": "volume_climax",
                "type": "volume",
                "params": {
                    "period": 20,
                    "ratio_ultra": 2.2,
                    "ratio_very_high": 1.8,
                    "ratio_high": 1.2,
                    "ratio_normal": 0.8,
                    "ratio_low": 0.4
                },
                "enabled": true,
                "timeframe": "1h"
            }
        ],
        "entry_rules": [
            {
                "name": "Long: 3 Blue Vol + 3 Green Candles",
                "enabled": true,
                "position_side": "long",
                "weight": 0.5,
                "condition": {
                    "type": "and",
                    "conditions": [
                        {
                            "type": "indicator_value",
                            "operator": ">=",
                            "left_value": "indicator:vc_blue_streak",
                            "right_value": 3
                        },
                        {
                            "type": "indicator_value",
                            "operator": ">=",
                            "left_value": "indicator:green_candle_streak",
                            "right_value": 3
                        }
                    ]
                }
            },
            {
                "name": "Short: 3 Blue Vol + 3 Red Candles",
                "enabled": true,
                "position_side": "short",
                "weight": 0.5,
                "condition": {
                    "type": "and",
                    "conditions": [
                        {
                            "type": "indicator_value",
                            "operator": ">=",
                            "left_value": "indicator:vc_blue_streak",
                            "right_value": 3
                        },
                        {
                            "type": "indicator_value",
                            "operator": ">=",
                            "left_value": "indicator:red_candle_streak",
                            "right_value": 3
                        }
                    ]
                }
            }
        ],
        "exit_rules": [],
        "filter_rules": [],
        "risk_management": {}
    },
    "initial_capital": 10000,
    "position_sizing": "fixed",
    "position_size_percent": 0.25,
    "max_positions": 3,
    "commission_rate": 0.001,
    "slippage_percent": 0.001,
    "stop_loss_percent": 5,
    "take_profit_percent": 3.0,
    "trailing_stop_percent": 2,
    "max_daily_loss_percent": 5,

{
    "name": "SMC Order Block Pure Strategy",
    "version": "1.0.3",
    "description": "استراتيجية تعتمد حصراً على اختراق أو ملامسة مناطق الطلب والعرض (Order Blocks)",
    "base_timeframe": "1h",
    "position_side": "both",
    "indicators": [
        {
            "id": "smc_order_block",
            "name": "smc_order_block",
            "type": "support_resistance",
            "params": {
                "swing_length": 10,
                "close_mitigation": true,
                "show_last_n_blocks": 2,
                "lookback_period": 200
            },
            "enabled": true,
            "timeframe": "1h"
        }
    ],
    "entry_rules": [
        {
            "name": "Long: Price Exceeds Bullish OB",
            "enabled": true,
            "position_side": "long",
            "weight": 0.5,
            "condition": {
                "type": "or",
                "conditions": [
                    {
                        "type": "indicator_value",
                        "operator": "cross_above",
                        "left_value": "price:close",
                        "right_value": "indicator:smc_order_block:bullish_zone_top"
                    },
                    {
                        "type": "indicator_value",
                        "operator": "touches",
                        "left_value": "price:low",
                        "right_value": "indicator:smc_order_block:bullish_zone_bottom"
                    }
                ]
            }
        },
        {
            "name": "Short: Price Exceeds Bearish OB",
            "enabled": true,
            "position_side": "short",
            "weight": 0.5,
            "condition": {
                "type": "or",
                "conditions": [
                    {
                        "type": "indicator_value",
                        "operator": "cross_below",
                        "left_value": "price:close",
                        "right_value": "indicator:smc_order_block:bearish_zone_bottom"
                    },
                    {
                        "type": "indicator_value",
                        "operator": "touches",
                        "left_value": "price:high",
                        "right_value": "indicator:smc_order_block:bearish_zone_top"
                    }
                ]
            }
        }
    ],
    "exit_rules": [],
    "filter_rules": [],
    "risk_management": {}
}
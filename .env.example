# =============================================================================
# Trading Backend API — Environment Variables Template
# قالب متغيرات البيئة — منصة التداول الخلفية
#
# Usage:
#   cp .env.example .env               # local development
#   cp .env.example .env.production    # production (fill REAL secrets!)
#
# NEVER commit files containing real secrets (.env / .env.production are
# gitignored). Generate a JWT secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# =============================================================================

# --- Application --------------------------------------------------------------
# DEBUG / DISABLE_AUTH must be false in production. DISABLE_AUTH=true skips
# JWT verification on protected endpoints — development convenience ONLY.
DEBUG=false
DISABLE_AUTH=false
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
# LOG_FILE=/app/logs/trading_system.log

# --- Database (PostgreSQL / Neon) -----------------------------------------------
# The app uses the async driver, so the URL MUST start with postgresql+asyncpg://
#   Local docker:  postgresql+asyncpg://trader:trader@postgres:5432/trading_db
#   Local native:  postgresql+asyncpg://trader:trader@localhost:5432/trading_db
#   Neon:          postgresql+asyncpg://owner:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/trading_db

# --- Redis (local / docker / Upstash) ---------------------------------------------
#   Local native:  redis://localhost:6379/0
#   Docker:        redis://redis:6379/0
#   Upstash:       redis://default:PASSWORD@host.upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# --- Security / JWT -----------------------------------------------------------------
SECRET_KEY=CHANGE-ME-GENERATE-A-REAL-KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Encryption (Fernet key used to encrypt stored provider API keys) ----------------
ENCRYPTION_KEY=CHANGE-ME-GENERATE-A-REAL-FERNET-KEY

# --- CORS ------------------------------------------------------------------------------
# JSON list format. config.py consumes CORS_ORIGINS; the legacy name
# ALLOWED_ORIGINS is kept for compatibility with existing deployment files.
CORS_ORIGINS=["http://localhost:3000","http://localhost:3007"]
# ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3007"]

# --- Market data providers ---------------------------------------------------------------
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
BINANCE_API_URL=https://api.binance.com
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key   # free tier: 25 requests/day
ALPACA_API_KEY=                                    # unused (provider disabled)
ALPACA_SECRET_KEY=                                 # unused (provider disabled)
POLYGON_API_KEY=
# BINANCE_API_KEY=                                 # optional (public WS/REST need none)
# BINANCE_SECRET_KEY=                              # optional

# --- Celery (async backtests) ----------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Email / SMTP (verification + password reset) ------------------------------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com
